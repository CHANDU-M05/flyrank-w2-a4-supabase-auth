# Copy to .env, then fill in real values. Never commit .env.
#   cp .env.example .env
#
# Three variables are what the assignment names. The fourth is this app's own database
# connection, used only by the task CRUD carried over from Weeks 2/3.

# --- Supabase Auth ------------------------------------------------------------
# A hosted project: Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project.supabase.co

# The public key: `sb_publishable_…` on a current project, `anon` on an older one. It is not a secret
# in the usual sense — it identifies your project, and Row Level Security is what protects the data —
# but it still does not belong in a commit, because a key scoped to one project published in a public
# repository is a key that now belongs to everyone who reads it.
#
# The privileged key (`sb_secret_…`, or `service_role` on older projects) bypasses Row Level Security
# entirely. It must never appear in this file, in server logs, or in this repository — and
# src/config.js refuses to start when SUPABASE_KEY holds one, so pasting it here by mistake fails
# loudly at boot instead of quietly weakening the app.
SUPABASE_KEY=your-anon-or-publishable-key

# --- Server -------------------------------------------------------------------
PORT=3000

# --- Postgres (task CRUD only) -------------------------------------------------
# For a hosted project this is Dashboard -> Project Settings -> Database -> Connection string,
# with `sslmode=require` appended for the direct connection. Locally it is the `DB URL` line that
# `npx supabase start` prints; it is not written down here, because a template that carries a usable
# credential — even a throwaway one — trains the wrong habit.
DATABASE_URL=postgresql://postgres:your-database-password@127.0.0.1:54322/postgres

# --- Running it locally without a Supabase account ----------------------------
# `npx supabase start` (the CLI is a devDependency, pinned in package.json) brings up Auth, Kong,
# PostgREST and Postgres on this machine and prints the values for the four variables above:
#
#   SUPABASE_URL     the `Project URL` line, http://127.0.0.1:54321 (Kong adds the /auth/v1 prefix
#                    that the client expects — do not put that path in SUPABASE_URL yourself)
#   SUPABASE_KEY     the `Publishable` key  — not the `Secret` one; src/config.js refuses it
#   DATABASE_URL     the `DB URL` line, postgresql://…@127.0.0.1:54322/postgres
#   PORT             3000
#
# Those are throwaway development credentials for containers on this machine's loopback interface.
# They are still kept out of git, so that "no credential in the repository" is a habit rather than
# a rule you have to remember only when the key matters.
